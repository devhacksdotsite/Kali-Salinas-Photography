---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy Policy for Nums n' Snugs — how I collect, use, and protect your personal information."
  noindex={true}
>
  <section class="py-16 md:py-24">
    <Container maxWidth="max-w-3xl">
      <h1 class="text-4xl md:text-5xl mb-8">Privacy Policy</h1>
      <p class="text-sm text-foreground/50 mb-12">Last updated: July 2026</p>

      <div class="space-y-8 text-foreground/70 leading-relaxed">
        <div>
          <h2 class="text-xl text-foreground mb-3">Overview</h2>
          <p>
            Nums n' Snugs LLC ("I", "me", "my") operates the website numsandsnugs.com.
            This page informs you of my policies regarding the collection, use, and
            protection of personal information when you use this website.
          </p>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">Information I Collect</h2>
          <p class="mb-3">
            When you submit the contact form on this website, I collect the following
            information that you voluntarily provide:
          </p>
          <ul class="list-disc list-inside space-y-1 ml-4">
            <li>Name</li>
            <li>Email address</li>
            <li>Phone number (optional)</li>
            <li>Session type preference</li>
            <li>Preferred date (optional)</li>
            <li>Message content</li>
          </ul>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">How I Use Your Information</h2>
          <p>
            The information you provide is used solely to respond to your inquiry,
            schedule sessions, and communicate with you about my photography services.
            I will never sell, rent, or share your personal information with third
            parties for marketing purposes.
          </p>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">Third-Party Services</h2>
          <p class="mb-3">This website uses the following third-party services:</p>
          <ul class="list-disc list-inside space-y-2 ml-4">
            <li>
              <strong>Formspree</strong> — processes contact form submissions. Your form
              data is transmitted to and stored by Formspree. See their
              <a href="https://formspree.io/legal/privacy-policy" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">privacy policy</a>.
            </li>
            <li>
              <strong>Cloudinary</strong> — serves and optimizes images displayed on this
              website. Cloudinary may collect standard web server logs. See their
              <a href="https://cloudinary.com/privacy" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">privacy policy</a>.
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">Cookies & Tracking</h2>
          <p>
            This website does not use cookies, analytics tracking, or any form of
            behavioral monitoring. No advertising pixels or social media trackers are
            present on this site.
          </p>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">Data Retention</h2>
          <p>
            Contact form submissions are retained only as long as needed to respond to
            your inquiry and complete any resulting business relationship. You may
            request deletion of your data at any time by contacting me directly.
          </p>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">Your Rights</h2>
          <p>You have the right to:</p>
          <ul class="list-disc list-inside space-y-1 ml-4 mt-2">
            <li>Request access to the personal data I hold about you</li>
            <li>Request correction or deletion of your data</li>
            <li>Withdraw consent for future communications</li>
          </ul>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">Children's Privacy</h2>
          <p>
            This website is not directed at children under 13. I do not knowingly
            collect personal information from children. Photography sessions involving
            minors are booked by and with the consent of a parent or legal guardian.
          </p>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">Changes to This Policy</h2>
          <p>
            I may update this privacy policy from time to time. Changes will be posted
            on this page with an updated revision date.
          </p>
        </div>

        <div>
          <h2 class="text-xl text-foreground mb-3">Contact</h2>
          <p>
            If you have any questions about this privacy policy or your personal data,
            please reach out via the <a href="/contact" class="text-accent hover:underline">contact page</a>.
          </p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
