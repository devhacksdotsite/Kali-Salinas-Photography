---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import { creator } from "../data/creator";
---
<BaseLayout title="Privacy Policy" description={`Privacy Policy for ${creator.name}.`} noindex={true}>
  <section class="py-16 md:py-24"><Container maxWidth="max-w-3xl">
    <h1 class="mb-8 text-4xl md:text-5xl">Privacy Policy</h1>
    <p class="mb-12 text-sm text-foreground/50">Last updated: September 2026</p>
    <div class="space-y-8 leading-relaxed text-foreground/70">
      <div><h2 class="mb-3 text-xl text-foreground">Overview</h2><p>{creator.name} operates this website. This policy explains what information may be collected when you contact Kali about UGC services and how it is used.</p></div>
      <div><h2 class="mb-3 text-xl text-foreground">Information collected</h2><p>If you contact Kali by email, she receives the information you choose to include, such as your name, email address, company, product details, and message.</p></div>
      <div><h2 class="mb-3 text-xl text-foreground">How information is used</h2><p>Information is used to respond to inquiries, discuss potential projects, and communicate about creator services. Personal information is not sold or shared for marketing purposes.</p></div>
      <div><h2 class="mb-3 text-xl text-foreground">Cookies and third parties</h2><p>This site does not intentionally use advertising cookies or behavioral tracking. If embedded media or third-party services are added later, their own privacy policies may apply.</p></div>
      <div><h2 class="mb-3 text-xl text-foreground">Contact</h2><p>Questions about this policy can be sent to <a href={`mailto:${creator.email}`} class="text-accent hover:underline">{creator.email}</a>.</p></div>
    </div>
  </Container></section>
</BaseLayout>
