---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import SectionTitle from "../components/common/SectionTitle.astro";
import Button from "../components/common/Button.astro";
import { packages } from "../data/pricing";
---

<BaseLayout
  title="Pricing"
  description="Transparent photography pricing for family, portrait, couples, and wedding sessions with Nums n' Snugs. Serving Arizona and Southern California."
>
  <section class="py-16 md:py-24">
    <Container>
      <SectionTitle
        title="Investment"
        subtitle="Beautiful images are an investment in your memories. Here's what to expect."
        as="h1"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {packages.map((pkg) => (
          <div
            class:list={[
              "relative rounded-lg border p-8 flex flex-col",
              pkg.featured
                ? "border-accent shadow-lg ring-1 ring-accent/20"
                : "border-border bg-white",
            ]}
          >
            {pkg.featured && (
              <span class="absolute -top-3 left-6 bg-accent text-white text-xs font-semibold px-3 py-1 rounded-full">
                Most Popular
              </span>
            )}

            <h2 class="text-2xl mb-2">{pkg.title}</h2>
            <p class="text-sm text-foreground/60 mb-4">{pkg.description}</p>

            <div class="mb-6">
              <span class="text-3xl font-heading font-medium text-foreground">
                ${pkg.startingPrice.toLocaleString()}
              </span>
              <span class="text-sm text-foreground/50 ml-1">starting at</span>
            </div>

            <div class="mb-6 pb-6 border-b border-border">
              <div class="flex items-center gap-2 text-sm text-foreground/70">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {pkg.sessionLength}
              </div>
            </div>

            <ul class="space-y-3 mb-8 flex-1">
              {pkg.deliverables.map((item) => (
                <li class="flex items-start gap-2 text-sm text-foreground/70">
                  <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>

            <Button
              href="/contact"
              variant={pkg.featured ? "primary" : "outline"}
              fullWidth
            >
              Book This Session
            </Button>
          </div>
        ))}
      </div>

      <!-- Note -->
      <div class="max-w-3xl mx-auto mt-16 text-center">
        <p class="text-foreground/60 text-sm leading-relaxed">
          All sessions include a pre-session consultation, professional editing, and an online
          gallery. Custom packages and mini sessions are available —
          <a href="/contact" class="text-accent hover:underline">reach out</a> and let's
          create something perfect for you.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
