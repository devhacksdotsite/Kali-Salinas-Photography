---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalBusinessSchema } from "../utils/seo";
---

<BaseLayout
  title="San Diego Family Photographer"
  description="Natural family, portrait, and lifestyle photography serving Arizona and Southern California."
  jsonLd={getLocalBusinessSchema()}
>
  <section class="flex items-center justify-center min-h-[60vh] px-4 text-center">
    <div>
      <h1 class="text-4xl md:text-6xl mb-4">Kali Salinas Photography</h1>
      <p class="text-lg text-foreground/70 max-w-xl mx-auto">
        Natural, timeless photography for families, couples, and portraits in Arizona and Southern California.
      </p>
    </div>
  </section>
</BaseLayout>
