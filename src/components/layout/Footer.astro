---
import { navLinks } from "../../data/navigation";
import { socialLinks } from "../../data/social";
import Container from "../common/Container.astro";
---

<footer class="border-t border-border py-12 mt-auto">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <!-- Brand -->
      <div>
        <a href="/" class="font-heading text-2xl text-foreground no-underline hover:no-underline">
          Nums n' Snugs
        </a>
        <p class="mt-2 text-sm text-foreground/60 max-w-xs">
          Authentic, heartfelt family photography capturing genuine connections and the beautiful chaos of everyday life. Serving Arizona &amp; Southern California.
        </p>
      </div>

      <!-- Navigation -->
      <nav aria-label="Footer navigation">
        <p class="text-sm font-body font-semibold uppercase tracking-wider text-foreground/40 mb-4">
          Navigation
        </p>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-foreground/70 hover:text-accent no-underline hover:no-underline transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Social -->
      <div>
        <p class="text-sm font-body font-semibold uppercase tracking-wider text-foreground/40 mb-4">
          Connect
        </p>
        <div class="flex items-center gap-4">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground/60 hover:text-accent transition-colors"
              aria-label={social.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-border text-center">
      <p class="text-sm text-foreground/50">
        &copy; {new Date().getFullYear()} Nums n' Snugs. All rights reserved.
      </p>
    </div>
  </Container>
</footer>
