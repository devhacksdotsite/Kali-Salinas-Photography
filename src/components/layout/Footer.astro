---
import { navLinks } from "../../data/navigation";
import { socialLinks } from "../../data/social";
import Container from "../common/Container.astro";
---

<footer class="border-t border-border py-12 mt-auto">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 font-heading text-2xl text-foreground no-underline hover:no-underline">
          <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect x="4" y="10" width="24" height="16" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <circle cx="16" cy="18" r="5" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <circle cx="16" cy="18" r="2" fill="currentColor"/>
            <path d="M12 10V8.5C12 7.67 12.67 7 13.5 7h5c.83 0 1.5.67 1.5 1.5V10" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="24" cy="13" r="1" fill="currentColor"/>
          </svg>
          Nums n' Snugs
        </a>
        <p class="mt-2 text-sm text-foreground/60 max-w-xs">
          Authentic lifestyle family photography serving Arizona and Southern California.
        </p>
      </div>

      <!-- Navigation -->
      <nav aria-label="Footer navigation">
        <p class="text-sm font-body font-semibold uppercase tracking-wider text-foreground/40 mb-4">
          Navigation
        </p>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-foreground/70 hover:text-accent no-underline hover:no-underline transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Social -->
      <div>
        <p class="text-sm font-body font-semibold uppercase tracking-wider text-foreground/40 mb-4">
          Connect
        </p>
        <div class="flex items-center gap-4">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground/60 hover:text-accent transition-colors"
              aria-label={social.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-border text-center">
      <p class="text-sm text-foreground/50">
        &copy; {new Date().getFullYear()} Nums n' Snugs LLC. All rights reserved.
      </p>
      <a href="/privacy" class="text-xs text-foreground/40 hover:text-accent transition-colors mt-2 inline-block">
        Privacy Policy
      </a>
    </div>
  </Container>
</footer>
