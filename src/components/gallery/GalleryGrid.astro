---
import Container from "../common/Container.astro";

interface Props {
  /** Additional classes for the grid container */
  class?: string;
}

const { class: className } = Astro.props;

const classes = [
  "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<Container>
  <div class={classes}>
    <slot />
  </div>
</Container>
