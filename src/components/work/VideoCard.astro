---
import type { Project } from "../../data/projects";
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="group">
  <div class="aspect-[9/16] overflow-hidden rounded-2xl bg-accent-light/70">
    <video
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      controls
      controlsList="nodownload"
      disablePictureInPicture
      preload="none"
      poster={project.poster}
      playsinline
      aria-label={project.alt}
    >
      <source src={project.video} type="video/mp4" />
      Your browser does not support embedded video.
    </video>
  </div>
  <div class="mt-4 flex items-start justify-between gap-4">
    <div>
      <h3 class="font-body text-base font-semibold">{project.brand ?? project.title}</h3>
      {project.description && <p class="mt-1 text-sm text-foreground/60">{project.description}</p>}
    </div>
    <div class="shrink-0 text-right text-xs uppercase tracking-[0.14em] text-accent">
      <span>{project.category}</span>
      {project.format && <span class="mt-1 block text-foreground/40">{project.format}</span>}
    </div>
  </div>
</article>
