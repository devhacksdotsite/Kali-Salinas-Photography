---
import Container from "../common/Container.astro";
import Button from "../common/Button.astro";
import { getImageUrl, getSrcSet, getSizes } from "../../utils/cloudinary";

const portraitImage = "kali-photography/about/portrait";
---

<section class="py-16 md:py-24 reveal">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <!-- Portrait -->
      <div class="order-2 md:order-1">
        <div class="aspect-[3/4] rounded-lg overflow-hidden">
          <img
            src={getImageUrl(portraitImage, { width: 640, crop: "fill", aspectRatio: "3:4", gravity: "face" })}
            srcset={getSrcSet(portraitImage, { crop: "fill", aspectRatio: "3:4", gravity: "face" })}
            sizes={getSizes("half")}
            alt="Nums n' Snugs photographer"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Bio -->
      <div class="order-1 md:order-2">
        <h2 class="text-3xl md:text-4xl mb-6">Hi, I'm Kali.</h2>
        <p class="text-foreground/70 mb-4 leading-relaxed">
          As a mother of five, I know that the moments you'll treasure most aren't the
          perfectly posed ones — they're the spontaneous laughs, the quiet embraces, and
          the beautiful chaos that makes your family uniquely yours.
        </p>
        <p class="text-foreground/70 mb-8 leading-relaxed">
          My photography is rooted in storytelling. Every session is relaxed and authentic,
          capturing genuine emotion through an artistic lens that tells your story naturally.
        </p>
        <Button href="/about" variant="secondary">
          More About Me
        </Button>
      </div>
    </div>
  </Container>
</section>
