---
import Container from "../common/Container.astro";
---
<section id="about" class="scroll-mt-24 border-t border-border py-20 md:py-28 reveal">
  <Container>
    <div class="grid items-center gap-10 md:grid-cols-[0.65fr_1.35fr] md:gap-16">
      <div class="reveal-child reveal-image mx-auto w-full max-w-sm overflow-hidden rounded-2xl bg-accent-light">
        <img src="/images/kali-portrait.jpg" alt="Kali Salinas smiling in a close-up portrait" class="aspect-[3/4] h-full w-full object-cover" loading="lazy" decoding="async" />
      </div>
      <div class="reveal-child max-w-2xl" style="--reveal-delay: 140ms">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">About Kali</p>
        <h2 class="mt-4 text-4xl leading-tight md:text-5xl">Content that feels like a recommendation from a friend.</h2>
        <p class="mt-6 text-base leading-relaxed text-foreground/65">I'm a creator based in Arizona, making short-form content across travel, beauty, lifestyle, and tech. I care about the details that make a product feel useful, approachable, and worth sharing.</p>
        <p class="mt-4 text-base leading-relaxed text-foreground/65">My goal is simple: create natural, engaging videos that help the right people see themselves using your product.</p>
      </div>
    </div>
  </Container>
</section>
