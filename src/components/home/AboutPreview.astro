---
import Container from "../common/Container.astro";
---
<section id="about" class="scroll-mt-24 border-t border-border py-20 md:py-28 reveal">
  <Container>
    <div class="grid items-center gap-10 md:grid-cols-[0.65fr_1.35fr] md:gap-16">
      <div class="reveal-child reveal-image relative mx-auto w-full max-w-sm">
        <div class="absolute -inset-5 -z-10 rotate-[4deg] rounded-[2rem] bg-accent-light/70 shadow-xl shadow-accent/10" aria-hidden="true"></div>
        <div class="absolute -inset-2 -z-10 rotate-[-2deg] rounded-[1.5rem] border border-accent/15 bg-background/70" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-2xl bg-accent-light">
          <img src="/images/kali-about.jpg" alt="Kali Salinas smiling in a close-up portrait" class="aspect-[3/4] h-full w-full object-cover object-[center_35%]" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="reveal-child max-w-2xl" style="--reveal-delay: 140ms">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">About Kali</p>
        <h2 class="mt-4 text-4xl leading-tight md:text-5xl">Hi, I'm Kali!</h2>
        <p class="mt-6 text-base leading-relaxed text-foreground/65">I'm an Arizona-based lifestyle creator, wife, mom of five, and the kind of girl who always has something to talk about.</p>
        <p class="mt-4 text-base leading-relaxed text-foreground/65">I love discovering new products, sharing my favorite finds, and turning everyday moments into content that feels natural, fun, and genuinely relatable.</p>
        <p class="mt-4 text-base leading-relaxed text-foreground/65">Whether it's beauty, travel, lifestyle, or something that makes everyday life a little easier, I love creating content that feels less like an ad and more like a recommendation from a friend.</p>
        <p class="mt-4 text-base leading-relaxed text-foreground/65">Because the best content doesn't have to feel like someone is trying to sell you something.</p>
      </div>
    </div>
  </Container>
</section>
