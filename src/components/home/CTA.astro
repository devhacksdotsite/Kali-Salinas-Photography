---
import Container from "../common/Container.astro";
import Button from "../common/Button.astro";
---

<section class="py-16 md:py-24 reveal">
  <Container maxWidth="max-w-4xl">
    <div class="text-center">
      <h2 class="text-3xl md:text-4xl mb-4">Ready to Create Something Beautiful?</h2>
      <p class="text-lg text-foreground/60 mb-8 max-w-2xl mx-auto">
        Let's plan a session that's uniquely you. I'd love to hear about your vision and bring it to life.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/contact" variant="primary">
          Get in Touch
        </Button>
        <Button href="/pricing" variant="outline">
          View Pricing
        </Button>
      </div>
    </div>
  </Container>
</section>
