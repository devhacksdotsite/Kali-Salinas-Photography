---
import Button from "../common/Button.astro";
import { creator } from "../../data/creator";
---
<section class="border-b border-border px-5 pb-20 pt-20 md:px-8 md:pb-28 md:pt-28">
  <div class="mx-auto max-w-6xl reveal-fade">
    <p class="mb-6 text-xs font-semibold uppercase tracking-[0.24em] text-accent">{creator.name}</p>
    <div class="grid items-end gap-8 lg:grid-cols-[1.2fr_0.8fr]">
      <h1 class="max-w-4xl text-5xl leading-[0.98] sm:text-6xl md:text-8xl">Lifestyle UGC for brands people love.</h1>
      <div class="max-w-md pb-1 lg:justify-self-end">
        <p class="text-base leading-relaxed text-foreground/65 md:text-lg">Short-form content from Arizona for travel, beauty, lifestyle, and tech brands that feels native to the platform.</p>
        <div class="mt-8 flex flex-wrap gap-3"><Button href="#work" variant="primary">View my work</Button><Button href="#contact" variant="outline">Let's work together</Button></div>
      </div>
    </div>
  </div>
</section>
