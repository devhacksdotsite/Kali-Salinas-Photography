---
import Button from "../common/Button.astro";
import { getImageUrl, getSrcSet, getSizes } from "../../utils/cloudinary";

const heroImage = "615BB448-A5C5-49DE-AE65-3F317F989078";

// Desktop / landscape crop (wide screens)
const heroUrl = getImageUrl(heroImage, { width: 1920, crop: "fill", gravity: "auto" });
const heroSrcSet = getSrcSet(heroImage, { crop: "fill", gravity: "auto" });

// Mobile / portrait crop — taller aspect ratio so the subject isn't over-zoomed
const heroMobileSrcSet = getSrcSet(
  heroImage,
  { crop: "fill", gravity: "auto", aspectRatio: "3:4" },
  [320, 480, 640, 768],
);
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <picture>
      <!-- Portrait crop for small screens -->
      <source
        media="(max-width: 767px)"
        srcset={heroMobileSrcSet}
        sizes="100vw"
      />
      <!-- Landscape crop for larger screens -->
      <source
        media="(min-width: 768px)"
        srcset={heroSrcSet}
        sizes="100vw"
      />
      <img
        src={heroUrl}
        srcset={heroSrcSet}
        sizes={getSizes("full")}
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
    </picture>
    <!-- Overlay -->
    <div class="absolute inset-0 bg-foreground/15"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-3xl mx-auto reveal-fade">
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white mb-6 drop-shadow-lg">
      Life As It Happens,<br />Beautifully Preserved
    </h1>
    <p class="text-lg md:text-xl text-white/90 mb-8 max-w-xl mx-auto font-body">
      Authentic, heartfelt family photography that captures genuine connections, quiet moments, and the beautiful chaos that makes your family uniquely yours.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/portfolio" variant="primary">
        View Portfolio
      </Button>
      <Button href="/pricing" variant="outline" class="border-white text-white hover:!bg-white hover:!text-foreground">
        Book a Session
      </Button>
    </div>
  </div>
</section>
