---
import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import Card from "../common/Card.astro";
import { services } from "../../data/services";
import { getImageUrl, getSrcSet, getSizes } from "../../utils/cloudinary";
---

<section class="py-16 md:py-24 bg-accent-light/40 reveal">
  <Container>
    <SectionTitle
      title="What I Offer"
      subtitle="Every session is tailored to you — relaxed, authentic, and full of real moments."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => (
        <Card href={service.href} hoverable noPadding>
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={getImageUrl(service.image, { width: 480, crop: "fill", aspectRatio: "4:3" })}
              srcset={getSrcSet(service.image, { crop: "fill", aspectRatio: "4:3" })}
              sizes={getSizes("third")}
              alt={service.title}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-5">
            <h3 class="text-lg mb-2">{service.title}</h3>
            <p class="text-sm text-foreground/60">{service.description}</p>
          </div>
        </Card>
      ))}
    </div>
  </Container>
</section>
