---
import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import { testimonials } from "../../data/testimonials";
---

<section class="py-16 md:py-24 bg-secondary/10 reveal">
  <Container>
    <SectionTitle
      title="Kind Words"
      subtitle="What my clients have to say about their experience."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {testimonials.map((testimonial) => (
        <blockquote class="bg-white rounded-lg p-8 border border-border">
          <svg
            class="w-8 h-8 text-accent/30 mb-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H0z" />
          </svg>
          <p class="text-foreground/80 leading-relaxed mb-6 italic">
            {testimonial.quote}
          </p>
          <footer class="flex items-center gap-2">
            <cite class="not-italic font-semibold text-foreground text-sm">
              {testimonial.name}
            </cite>
            <span class="text-foreground/30">·</span>
            <span class="text-sm text-foreground/50">{testimonial.context}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </Container>
</section>
