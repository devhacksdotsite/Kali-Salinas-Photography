---
const formAction = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? "https://formspree.io/f/your-form-id";

const sessionTypes = [
  "Quick Mini (10 min)",
  "Classic Mini (15 min)",
  "Extended Mini (30 min)",
  "Portraits",
  "Couples / Engagement",
  "Full Session (60 min)",
  "Other",
];
---

<!-- Form -->
<form
  id="contact-form"
  action={formAction}
  method="POST"
  class="space-y-6"
>
  <!-- Name -->
  <div>
    <label for="name" class="block text-sm font-medium text-foreground mb-1.5">
      Name <span class="text-accent">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      autocomplete="name"
      class="w-full px-4 py-3 rounded-lg border border-border bg-white text-foreground placeholder:text-foreground/40 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
      placeholder="Your full name"
    />
  </div>

  <!-- Email -->
  <div>
    <label for="email" class="block text-sm font-medium text-foreground mb-1.5">
      Email <span class="text-accent">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      class="w-full px-4 py-3 rounded-lg border border-border bg-white text-foreground placeholder:text-foreground/40 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
      placeholder="you@email.com"
    />
  </div>

  <!-- Phone -->
  <div>
    <label for="phone" class="block text-sm font-medium text-foreground mb-1.5">
      Phone
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      autocomplete="tel"
      pattern="\(\d{3}\)\s?\d{3}-\d{4}"
      maxlength="14"
      class="w-full px-4 py-3 rounded-lg border border-border bg-white text-foreground placeholder:text-foreground/40 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
      placeholder="(555) 123-4567"
      title="Phone number in format (555) 123-4567"
    />
  </div>

  <!-- Session Type -->
  <div>
    <label for="session-type" class="block text-sm font-medium text-foreground mb-1.5">
      Session Type <span class="text-accent">*</span>
    </label>
    <select
      id="session-type"
      name="session_type"
      required
      class="w-full px-4 py-3 rounded-lg border border-border bg-white text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors appearance-none"
    >
      <option value="" disabled selected>Select a session type</option>
      {sessionTypes.map((type) => (
        <option value={type}>{type}</option>
      ))}
    </select>
  </div>

  <!-- Preferred Date -->
  <div>
    <label for="preferred-date" class="block text-sm font-medium text-foreground mb-1.5">
      Preferred Date
    </label>
    <input
      type="date"
      id="preferred-date"
      name="preferred_date"
      class="w-full px-4 py-3 rounded-lg border border-border bg-white text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
    />
  </div>

  <!-- Message -->
  <div>
    <label for="message" class="block text-sm font-medium text-foreground mb-1.5">
      Message <span class="text-accent">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      required
      rows="5"
      class="w-full px-4 py-3 rounded-lg border border-border bg-white text-foreground placeholder:text-foreground/40 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors resize-y"
      placeholder="Tell me about your vision — location ideas, who will be in the session, and anything else I should know!"
    ></textarea>
  </div>

  <!-- Pinterest Board URL -->
  <div>
    <label for="pinterest" class="block text-sm font-medium text-foreground mb-1.5">
      Pinterest Board URL
      <span class="text-foreground/40 font-normal ml-1">(optional)</span>
    </label>
    <input
      type="url"
      id="pinterest"
      name="pinterest_url"
      class="w-full px-4 py-3 rounded-lg border border-border bg-white text-foreground placeholder:text-foreground/40 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
      placeholder="https://pinterest.com/your-board"
    />
    <p class="mt-1.5 text-xs text-foreground/40">
      Share a Pinterest board or pin that captures the vibe you're going for.
    </p>
  </div>

  <!-- Error message -->
  <p id="form-error" class="hidden text-sm text-red-600 text-center"></p>

  <!-- Honeypot - hidden from humans, catches bots -->
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

  <!-- Submit -->
  <button
    id="submit-btn"
    type="submit"
    class="w-full inline-flex items-center justify-center px-6 py-3 font-body font-semibold text-sm tracking-wide rounded-lg bg-accent text-white hover:bg-accent/90 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:opacity-50 disabled:cursor-not-allowed"
  >
    Send Message
  </button>

  <p class="text-xs text-foreground/50 text-center">
    I'll get back to you within 24–48 hours. Can't wait to hear from you!
  </p>
</form>

<!-- Thank You Message (hidden by default) -->
<div id="form-success" class="hidden text-center py-12">
  <svg class="w-16 h-16 text-accent mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
  <h2 class="text-2xl md:text-3xl mb-3 font-heading">Thank You!</h2>
  <p class="text-foreground/70 max-w-md mx-auto mb-6">
    Your message has been sent successfully. I'll review your inquiry and get back to you within 24–48 hours.
  </p>
  <p class="text-sm text-foreground/50">
    In the meantime, feel free to browse my <a href="/portfolio" class="text-accent hover:underline">portfolio</a> or follow me on <a href="https://instagram.com/numsandsnugs" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Instagram</a>.
  </p>
</div>

<script>
  // Pre-select session type from URL query param (e.g., ?session=Quick+Mini)
  const urlParams = new URLSearchParams(window.location.search);
  const sessionParam = urlParams.get("session");

  if (sessionParam) {
    const select = document.getElementById("session-type") as HTMLSelectElement | null;
    if (select) {
      const matchMap: Record<string, string> = {
        "Quick Mini": "Quick Mini (10 min)",
        "Classic Mini": "Classic Mini (15 min)",
        "Extended Mini": "Extended Mini (30 min)",
        "Portraits": "Portraits",
        "Couples & Engagement": "Couples / Engagement",
        "Full Session": "Full Session (60 min)",
      };
      const matchedValue = matchMap[sessionParam] ?? sessionParam;
      const option = Array.from(select.options).find((opt) => opt.value === matchedValue);
      if (option) {
        select.value = matchedValue;
      }
    }
  }

  // Phone number formatting
  const phoneInput = document.getElementById("phone") as HTMLInputElement | null;

  phoneInput?.addEventListener("input", (e) => {
    const input = e.target as HTMLInputElement;
    // Strip all non-digits
    const digits = input.value.replace(/\D/g, "").slice(0, 10);

    // Format as (XXX) XXX-XXXX
    let formatted = "";
    if (digits.length > 0) formatted = `(${digits.slice(0, 3)}`;
    if (digits.length >= 3) formatted = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}`;
    if (digits.length >= 6) formatted = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6, 10)}`;

    input.value = formatted;
  });

  // AJAX form submission
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const successEl = document.getElementById("form-success");
  const errorEl = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!submitBtn || !form) return;

    // Disable button and show loading state
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";
    errorEl?.classList.add("hidden");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        // Hide form, show success
        form.classList.add("hidden");
        successEl?.classList.remove("hidden");
      } else {
        const data = await response.json();
        const message = data?.errors?.map((err: { message: string }) => err.message).join(", ") || "Something went wrong. Please try again.";
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.classList.remove("hidden");
        }
        submitBtn.disabled = false;
        submitBtn.textContent = "Send Message";
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = "Network error. Please check your connection and try again.";
        errorEl.classList.remove("hidden");
      }
      submitBtn.disabled = false;
      submitBtn.textContent = "Send Message";
    }
  });
</script>
